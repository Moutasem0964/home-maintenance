{
  "info": {
    "name": "Home Maintenance API",
    "description": "Domain-organized collection. Set {{base_url}}; login/register auto-saves {{token}} for authed requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "https://home-maintenance.me", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "otp_code", "value": "", "type": "string" },
    { "key": "reset_code", "value": "", "type": "string" },
    { "key": "order_id", "value": "", "type": "string" },
    { "key": "technician_id", "value": "", "type": "string" },
    { "key": "offer_id", "value": "", "type": "string" },
    { "key": "quote_id", "value": "", "type": "string" },
    { "key": "closure_code", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register — Start (send OTP)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "const json = pm.response.json();",
                "if (json.debug_code) { pm.collectionVariables.set('otp_code', json.debug_code); }"
              ] }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"phone\": \"0912345678\",\n  \"name\": \"Test Client\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/register/start", "host": ["{{base_url}}"], "path": ["api", "auth", "register", "start"] },
            "description": "Sends a 4-digit OTP. In dev (SMS_DRIVER=log) read it from storage/logs/laravel.log."
          }
        },
        {
          "name": "Register — Verify (create account)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "const json = pm.response.json();",
                "if (json.token) { pm.collectionVariables.set('token', json.token); }"
              ] }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"phone\": \"0912345678\",\n  \"code\": \"{{otp_code}}\",\n  \"name\": \"Test Client\",\n  \"password\": \"Password123\",\n  \"password_confirmation\": \"Password123\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/register/verify", "host": ["{{base_url}}"], "path": ["api", "auth", "register", "verify"] },
            "description": "Verifies the OTP, creates a client + wallet, returns a token (auto-saved to {{token}})."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "const json = pm.response.json();",
                "if (json.token) { pm.collectionVariables.set('token', json.token); }"
              ] }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"phone\": \"0912345678\",\n  \"password\": \"Password123\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/me", "host": ["{{base_url}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/logout", "host": ["{{base_url}}"], "path": ["api", "auth", "logout"] }
          }
        },
        {
          "name": "Password — Forgot",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "const json = pm.response.json();",
                "if (json.debug_code) { pm.collectionVariables.set('reset_code', json.debug_code); }"
              ] }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"phone\": \"0912345678\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/password/forgot", "host": ["{{base_url}}"], "path": ["api", "auth", "password", "forgot"] }
          }
        },
        {
          "name": "Password — Reset",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"phone\": \"0912345678\",\n  \"code\": \"{{reset_code}}\",\n  \"password\": \"NewPass123\",\n  \"password_confirmation\": \"NewPass123\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/password/reset", "host": ["{{base_url}}"], "path": ["api", "auth", "password", "reset"] }
          }
        }
      ]
    },
    {
      "name": "Wallet",
      "item": [
        {
          "name": "Get Wallet",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/wallet", "host": ["{{base_url}}"], "path": ["api", "wallet"] }
          }
        },
        {
          "name": "Top Up",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"amount\": \"50.00\",\n  \"gateway_reference\": \"gw-{{$timestamp}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/wallet/top-up", "host": ["{{base_url}}"], "path": ["api", "wallet", "top-up"] }
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "List Service Categories",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/categories", "host": ["{{base_url}}"], "path": ["api", "categories"] },
            "description": "PLANNED — not implemented yet. Returns active service categories (electric, plumbing, AC, appliances)."
          }
        }
      ]
    },
    {
      "name": "Addresses",
      "item": [
        {
          "name": "List My Addresses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/addresses", "host": ["{{base_url}}"], "path": ["api", "addresses"] },
            "description": "PLANNED — the authenticated client's saved addresses."
          }
        },
        {
          "name": "Create Address",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"label\": \"Home\",\n  \"lat\": 33.5138,\n  \"lng\": 36.2765,\n  \"building_no\": \"12\",\n  \"floor\": \"3\",\n  \"notes\": \"Near the pharmacy\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/addresses", "host": ["{{base_url}}"], "path": ["api", "addresses"] },
            "description": "PLANNED — create a new client address."
          }
        },
        {
          "name": "Update Address",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"label\": \"Work\",\n  \"lat\": 33.5100,\n  \"lng\": 36.2900,\n  \"building_no\": \"5\",\n  \"floor\": \"1\",\n  \"notes\": \"Office building\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/addresses/1", "host": ["{{base_url}}"], "path": ["api", "addresses", "1"] },
            "description": "PLANNED — update an address by id."
          }
        },
        {
          "name": "Delete Address",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/addresses/1", "host": ["{{base_url}}"], "path": ["api", "addresses", "1"] },
            "description": "PLANNED — delete an address by id."
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "const json = pm.response.json();",
                "if (json.data && json.data.id) { pm.collectionVariables.set('order_id', json.data.id); }"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"operation_id\": \"{{$guid}}\",\n  \"service_category_id\": 1,\n  \"address_id\": 1,\n  \"type\": \"urgent\",\n  \"description\": \"Leaking sink\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/orders", "host": ["{{base_url}}"], "path": ["api", "orders"] },
            "description": "Creates an order and holds the inspection fee in escrow. Requires a funded wallet (top up first). Auto-saves the new id to {{order_id}}. For a scheduled order, use type=scheduled and add scheduled_at (a future ISO datetime).\n\noperation_id is an idempotency token: reuse the SAME value to retry safely (a repeat returns the same order, the fee is held once). {{$guid}} generates a fresh one on each send — pin it to a fixed value to test idempotency."
          }
        },
        {
          "name": "List My Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/orders", "host": ["{{base_url}}"], "path": ["api", "orders"] }
          }
        },
        {
          "name": "Get Order",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/orders/{{order_id}}", "host": ["{{base_url}}"], "path": ["api", "orders", "{{order_id}}"] }
          }
        }
      ]
    },
    {
      "name": "Technician",
      "item": [
        {
          "name": "Register Technician",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "const json = pm.response.json();",
                "if (json.token) { pm.collectionVariables.set('token', json.token); }"
              ] }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"phone\": \"0913333333\",\n  \"code\": \"{{otp_code}}\",\n  \"name\": \"Tech Guy\",\n  \"password\": \"Password123\",\n  \"password_confirmation\": \"Password123\",\n  \"charter_accepted\": true\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/register/technician", "host": ["{{base_url}}"], "path": ["api", "auth", "register", "technician"] },
            "description": "Run Auth > Register — Start first with this phone so {{otp_code}} is set. Creates a technician (status=pending) and logs you in as them (saves {{token}})."
          }
        },
        {
          "name": "Approve Technician (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/admin/technicians/{{technician_id}}/approve", "host": ["{{base_url}}"], "path": ["api", "admin", "technicians", "{{technician_id}}", "approve"] },
            "description": "Admin only. Log in as an admin (Auth > Login) so {{token}} is an admin token, set {{technician_id}}, then approve → status active."
          }
        },
        {
          "name": "Technician — Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/technician/me", "host": ["{{base_url}}"], "path": ["api", "technician", "me"] }
          }
        },
        {
          "name": "Technician — Set Services",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"service_category_ids\": [1, 2]\n}"
            },
            "url": { "raw": "{{base_url}}/api/technician/services", "host": ["{{base_url}}"], "path": ["api", "technician", "services"] }
          }
        },
        {
          "name": "Technician — Set Availability",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"is_available\": true,\n  \"current_lat\": 33.5138,\n  \"current_lng\": 36.2765\n}"
            },
            "url": { "raw": "{{base_url}}/api/technician/availability", "host": ["{{base_url}}"], "path": ["api", "technician", "availability"] }
          }
        },
        {
          "name": "Technician — My Offers",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "const json = pm.response.json();",
                "if (json.data && json.data[0]) { pm.collectionVariables.set('offer_id', json.data[0].id); }"
              ] }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/technician/offers", "host": ["{{base_url}}"], "path": ["api", "technician", "offers"] },
            "description": "Open dispatch offers for the logged-in technician. Auto-saves the first offer's id to {{offer_id}}."
          }
        },
        {
          "name": "Technician — Accept Offer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/technician/offers/{{offer_id}}/accept", "host": ["{{base_url}}"], "path": ["api", "technician", "offers", "{{offer_id}}", "accept"] },
            "description": "Atomically take the job. 409 if the order was already taken or the offer expired."
          }
        },
        {
          "name": "Technician — Decline Offer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"reason\": \"busy\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/technician/offers/{{offer_id}}/decline", "host": ["{{base_url}}"], "path": ["api", "technician", "offers", "{{offer_id}}", "decline"] },
            "description": "Decline and re-offer the order to the next nearest technician."
          }
        }
      ]
    },
    {
      "name": "Quotes",
      "item": [
        {
          "name": "Send Quote (technician)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"labor_cost\": \"80.00\",\n  \"warranty_days\": 30,\n  \"justification\": null,\n  \"parts\": [\n    { \"name\": \"Valve\", \"price\": \"20.00\", \"classification\": \"standard\", \"image_url\": \"https://example.com/part.jpg\" }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/api/orders/{{order_id}}/quotes", "host": ["{{base_url}}"], "path": ["api", "orders", "{{order_id}}", "quotes"] },
            "description": "Assigned technician sends the initial quote (labor + parts). Order must be 'accepted'. A justification is required when the total exceeds the category guide price x the anomaly multiplier."
          }
        },
        {
          "name": "List Quotes",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "const json = pm.response.json();",
                "if (json.data && json.data[0]) { pm.collectionVariables.set('quote_id', json.data[0].id); }"
              ] }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/orders/{{order_id}}/quotes", "host": ["{{base_url}}"], "path": ["api", "orders", "{{order_id}}", "quotes"] },
            "description": "Client or assigned technician lists the order's quotes. Auto-saves the newest quote id to {{quote_id}}."
          }
        },
        {
          "name": "Approve Quote (client)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/quotes/{{quote_id}}/approve", "host": ["{{base_url}}"], "path": ["api", "quotes", "{{quote_id}}", "approve"] },
            "description": "Client approves -> holds the repair fee in escrow and moves the order to in_progress. 422 if the wallet can't cover it."
          }
        },
        {
          "name": "Reject Quote (client)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/quotes/{{quote_id}}/reject", "host": ["{{base_url}}"], "path": ["api", "quotes", "{{quote_id}}", "reject"] },
            "description": "Client rejects -> order closes as inspection_only."
          }
        }
      ]
    },
    {
      "name": "Closure",
      "item": [
        {
          "name": "Generate Closure Code (client)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "const json = pm.response.json();",
                "if (json.code) { pm.collectionVariables.set('closure_code', json.code); }"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/orders/{{order_id}}/closure/generate", "host": ["{{base_url}}"], "path": ["api", "orders", "{{order_id}}", "closure", "generate"] },
            "description": "Client generates the closure code (valid 10 min) and reads it to the technician. Auto-saves it to {{closure_code}} for convenience; in reality the technician gets it verbally and the server never sends it to their device."
          }
        },
        {
          "name": "Verify Closure (technician)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"code\": \"{{closure_code}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/orders/{{order_id}}/closure/verify", "host": ["{{base_url}}"], "path": ["api", "orders", "{{order_id}}", "closure", "verify"] },
            "description": "Assigned technician submits the code to complete the job. Order -> completed and a 48h dispute window opens; held funds release automatically after it (release cron)."
          }
        }
      ]
    }
  ]
}
